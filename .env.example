# Copy to .env.local (git-ignored) and fill in.
# Local development: run `npm run db:start` and copy the values it prints.
# Production/preview: set these in Vercel project settings, never in the repo.

# Supabase project URL. Local: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (publishable) key. Safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. BYPASSES RLS. Server-only: never prefix with NEXT_PUBLIC_.
# Used only by src/lib/supabase/admin.ts (user invites, scheduled jobs).
SUPABASE_SERVICE_ROLE_KEY=
